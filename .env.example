# Variables de entorno de la app de certificados.
# En GoDaddy se configuran en el panel de la app (no se sube ningún archivo .env).

SUPABASE_URL=https://nhyovijaojrcowgxbaif.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Es SECRETA:
# da acceso total a la base de datos. Solo en el panel de GoDaddy, nunca en el código ni en el zip.
SUPABASE_SECRET_KEY=
# Sitios desde los que el formulario puede llamar a esta app, separados por comas.
ALLOWED_ORIGINS=https://hcgatrading.com,https://www.hcgatrading.com
# PORT lo asigna GoDaddy automáticamente; solo hace falta en local.
# PORT=3000
